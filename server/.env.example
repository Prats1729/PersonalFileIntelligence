# Node Environment
NODE_ENV=development
PORT=5000

# Client Application URL (used for CORS and OAuth redirect)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database URL (Neon serverless or local)
DATABASE_URL=postgresql://postgres:password@localhost:5432/personal_library?sslmode=require

# Google Cloud OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# JWT & Session Secret (minimum 32 characters recommended for production)
SESSION_SECRET=generate-a-secure-random-32-character-secret-key-here

# AI / OCR Server Fallback API Keys (Optional if users supply keys via BYOK)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
GEMINI_API_KEY=AIzaSy-your-gemini-key-here

# Logging & Proxy Settings
LOG_LEVEL=info
TRUST_PROXY=false
